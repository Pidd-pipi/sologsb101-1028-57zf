{
  "name": "gbstudiotake-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "录音棚场次与 Take 标记台 - 纯前端 SPA（React 18 + TypeScript + Ant Design + Vite + Zustand + React Router + Dexie）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 22828",
    "typecheck": "tsc --noEmit",
    "verify:merge": "tsx scripts/verify-merge.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "verify": "tsx scripts/verify-merge.ts && tsx scripts/verify-migration.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
